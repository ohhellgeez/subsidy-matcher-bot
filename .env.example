# ===== API МАХ (обязательно) =====
# Токен бота из платформы МАХ для партнёров: Чат-боты -> ⋮ -> Настройки -> Токен.
MAX_BOT_TOKEN=your_token_here

# Базовый домен API (менять не нужно).
MAX_BASE_URL=https://platform-api2.max.ru
MAX_REQUEST_TIMEOUT=30

# CA-бандл для локального запуска вне Docker (сертификаты Минцифры).
# В Docker настраивается автоматически (Dockerfile добавляет certs/mincifry_ca.pem).
MAX_CA_BUNDLE=

# ===== Режим доставки событий =====
# polling  — Long Polling через GET /updates (для разработки и демо, не нужен публичный URL).
# webhook  — HTTPS-сервер на FastAPI (для production).
BOT_MODE=polling

# --- Long Polling (только при BOT_MODE=polling) ---
POLLING_TIMEOUT=30
POLLING_LIMIT=100
# Типы событий через запятую; пусто = получать все.
POLLING_EVENT_TYPES=

# --- Webhook (только при BOT_MODE=webhook) ---
# Должен быть https://..., порт 443, сертификат от доверенного ЦС (или Минцифры).
WEBHOOK_URL=
# Секрет для проверки заголовка X-Max-Bot-Api-Secret (5-256 символов).
WEBHOOK_SECRET=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_PATH=/webhook

# ===== PostgreSQL =====
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=max_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
